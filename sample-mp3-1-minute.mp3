<div class="table-wrap"><table class="kv"><tbody><tr><th scope="row">File name</th><td class="mono">sample-mp3-1-minute.mp3</td></tr><tr><th scope="row">Format</th><td><a href="/formats/mp3/">MP3</a> (MPEG-1 Audio Layer III)</td></tr><tr><th scope="row">Extension</th><td class="mono">.mp3</td></tr><tr><th scope="row">MIME type</th><td class="mono">audio/mpeg</td></tr><tr><th scope="row">Size</th><td>960,177 bytes (938 KB)</td></tr><tr><th scope="row">Kind</th><td>Binary</td></tr><tr><th scope="row">Signature</th><td class="mono">49 44 33</td></tr><tr><th scope="row">SHA-256</th><td class="mono">6c62f9ade75116c2e7db9fba818a7c51e79b5f685d841b670bf0d3b1d9969066</td></tr><tr><th scope="row">Created</th><td>2026-10-21</td></tr><tr><th scope="row">Validation</th><td>Exact size, signature bytes and structure checked when the generator was built; your copy is checked against the SHA-256 after it is created</td></tr><tr><th scope="row">Preview</th><td>Available on this page</td></tr><tr><th scope="row">Source</th><td>Generated in your browser by this site&#39;s generator; not copied from elsewhere</td></tr><tr><th scope="row">Licence</th><td>Free to use, modify and redistribute (<a href="/terms/">terms</a>)</td></tr><tr><th scope="row">Category</th><td><a href="/categories/audio/">Audio</a></td></tr></tbody></table></div>
